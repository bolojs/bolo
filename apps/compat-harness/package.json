{
  "name": "@bolojs/compat-harness",
  "version": "0.1.1-rc.0",
  "private": true,
  "type": "module",
  "bin": {
    "compat-harness": "./bin/cli.js"
  },
  "scripts": {
    "build": "vite build",
    "dev": "portless run --name compat-harness --force vite",
    "preview": "portless run --name compat-harness --force vite preview",
    "cli": "node bin/cli.js",
    "lint": "oxlint src bin",
    "format": "oxfmt --check src bin",
    "typecheck": "tsc --noEmit",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@bolojs/log": "workspace:*",
    "@bolojs/node-web-shims": "workspace:*",
    "@bolojs/runtime": "workspace:*"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "playwright-core": "^1.59.1",
    "portless": "latest",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^4.1.10"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
