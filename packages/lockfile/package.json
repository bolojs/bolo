{
  "name": "@bolojs/lockfile",
  "version": "0.3.0",
  "description": "Parse npm, yarn, yarn-berry, pnpm, and bun lockfiles into a unified dependency graph.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "oxlint src",
    "format": "oxfmt --check src '!**/fixtures/**'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hyrious/bun.lockb": "^0.0.4",
    "@yarnpkg/lockfile": "^1.1.0",
    "@yarnpkg/parsers": "^3.0.3",
    "js-yaml": "^5.2.1",
    "lockparse": "^0.2.2",
    "semver": "^7.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/semver": "^7.5.8",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "license": "Apache-2.0",
  "author": "Joaquin Terrasa <josocjoq+dev@pm.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bolojs/bolo.git",
    "directory": "packages/lockfile"
  },
  "homepage": "https://bolojs.dev/docs/api/",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "!dist/**/*.test.*",
    "!dist/**/*.test.*.map"
  ],
  "engines": {
    "node": ">=24.0.0"
  }
}
