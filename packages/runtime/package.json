{
  "name": "@bolojs/runtime",
  "version": "0.3.0",
  "description": "Core container API for bolo — boot a browser-native Node.js runtime with a pluggable sandbox backend.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "oxlint src",
    "format": "oxfmt --check src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bolojs/log": "workspace:*",
    "@bolojs/fs": "workspace:*",
    "@bolojs/sandbox": "workspace:*",
    "@bolojs/pm": "workspace:*",
    "@bolojs/vite-server": "workspace:*",
    "@bolojs/node-web-shims": "workspace:*",
    "@bolojs/node-runtime-shims": "workspace:*",
    "@bolojs/registry": "workspace:*",
    "isomorphic-git": "^1.38.7",
    "just-bash": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "happy-dom": "^20.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "license": "Apache-2.0",
  "author": "Joaquin Terrasa <josocjoq+dev@pm.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bolojs/bolo.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://bolojs.dev/docs/getting-started/",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "!dist/**/*.test.*",
    "!dist/**/*.test.*.map"
  ],
  "engines": {
    "node": ">=24.0.0"
  }
}
