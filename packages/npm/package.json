{
  "name": "@bolojs/pm",
  "version": "0.1.0",
  "description": "Browser-native npm package installer — registry resolve + tarball extract, no server required.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "oxlint src",
    "format": "oxfmt --check src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bolojs/log": "workspace:*",
    "@bolojs/lockfile": "workspace:*",
    "semver": "^7.6.0"
  },
  "devDependencies": {
    "@bolojs/fs": "workspace:*",
    "@types/semver": "^7.5.8",
    "memfs": "~4.56.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "license": "Apache-2.0",
  "author": "Joaquin Terrasa <josocjoq+dev@pm.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bolojs/bolo.git",
    "directory": "packages/npm"
  },
  "homepage": "https://bolojs.dev/docs/api/",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "!dist/**/*.test.*",
    "!dist/**/*.test.*.map"
  ],
  "engines": {
    "node": ">=24.0.0"
  }
}
